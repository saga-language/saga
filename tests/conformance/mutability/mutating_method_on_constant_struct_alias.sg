// An alias of a struct reaches the struct's methods, and with them which
// ones write, so a writing one cannot run on a constant of the alias.
import "std/io"

struct Counter {
  n int
}

pub fn (c Counter) Bump() void { c.n = c.n + 1 }

type Tally = Counter

const start Tally = Counter{n: 1}

pub fn Main() void {
  start.Bump()
  io.Println("{start.n}")
}
