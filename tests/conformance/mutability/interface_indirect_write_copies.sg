// A method that writes its receiver only by calling one that does still
// writes it, so a call through an interface box another name shares copies
// the box first.
import "std/io"

interface Resetter {
  Reset() void
  Count() int
}

struct Counter {
  n int
}

pub fn (c Counter) Bump() void { c.n = c.n + 1 }
pub fn (c Counter) Reset() void { c.Bump() }
pub fn (c Counter) Count() int { c.n }

pub fn Main() void {
  r Resetter = Counter{n: 1}
  shared := r
  shared.Reset()
  io.Println("{r.Count()} {shared.Count()}")
}
