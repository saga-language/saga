// Spec: "Values that escape their scope are copied." (docs/language.md:51)
// A function-call boundary is an escape; writing to the parameter inside the
// callee must not be visible to the caller. The copy is the one copy-on-write
// makes when the callee writes — the parameter slot holds a reference of its
// own, so a callee that only reads shares the buffer.
import "std/io"

fn grow(a array{int}) int {
  bigger := a.Append(99)
  bigger.Size()
}

fn overwrite(a array{int}) int {
  a[0] = 99
  a.At(0)
}

fn shrink(a array{int}) int {
  a.Pop()
  a.Size()
}

fn first(a array{int}) int { a.At(0) }

pub fn Main() void {
  arr := [1, 2, 3]
  inner_size := grow(arr)
  io.Println(inner_size.String())
  io.Println(arr.Size().String())

  io.Println("write {overwrite(arr)} {arr.At(0)}")
  io.Println("read {first(arr)} {first([5, 6])}")
  io.Println("pop {shrink(arr)} {arr.Size()}")
}
