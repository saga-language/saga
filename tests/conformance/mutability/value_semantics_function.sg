// Spec: "Values that escape their scope are copied." (docs/language.md:51)
// A function-call boundary is an escape; appending to the parameter inside
// the callee must not be visible to the caller.
import "std/io"

fn grow(a array{int}) int {
  bigger := a.Append(99)
  bigger.Size()
}

pub fn Main() void {
  arr := [1, 2, 3]
  inner_size := grow(arr)
  io.Println(inner_size.String())
  io.Println(arr.Size().String())
}
