// Spec: compound assignment operators on a float target use floating-point
// arithmetic. (docs/language.md:1344-1347)
import "std/io"

pub fn Main() void {
  f := 1.5
  f += 2.25
  io.Println(f.String())
  f -= 0.25
  io.Println(f.String())
  f *= 2.0
  io.Println(f.String())
  f /= 8.0
  io.Println(f.String())
}
