// Spec: structural embedding (`struct Child < Parent`) — child
// inherits parent's fields and methods. (docs/language.md:849-879)
import "std/io"

struct Greeter {}

pub fn (g Greeter) Greet() string { "Hello!" }

struct User < Greeter {
  name string
}

pub fn Main() void {
  u := User{name: "Alice"}
  io.Println(u.Greet())
}
