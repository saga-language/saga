// `Null` is a value that carries no information — what JSON and SQL mean by
// null — so `T | Null` models an optional. It is an ordinary field-less struct,
// so it needs no braces and `is` narrowing recovers which alternative is held.
import "std/io"

fn lookup(present bool) int | Null {
  if present {
    return 42
  }
  return Null
}

pub fn Main() void {
  a := lookup(true)
  if a is int {
    io.Println("a present")
  }
  if a is Null {
    io.Println("a missing")
  }

  b := lookup(false)
  if b is int {
    io.Println("b present")
  }
  if b is Null {
    io.Println("b missing")
  }
}
