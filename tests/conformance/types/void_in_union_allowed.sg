// The optional type: void is legal as a union alternative, which is the whole
// point of `T | void`. A void return type is legal too.
const io = import "std/io"

fn maybe(ok bool) int | void {
  if ok {
    return 7
  }
  null
}

pub fn Main() void {
  x := maybe(true)
  if x is int {
    io.Println(x.String())
  } else {
    io.Println("absent")
  }

  y := maybe(false)
  if y is int {
    io.Println(y.String())
  } else {
    io.Println("absent")
  }
}
