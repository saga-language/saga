// Spec: an interface union (`Reader | Writer`) requires *both* sets
// of methods to be implemented. Widens, not narrows.
// (docs/language.md:951-953)
import "std/io"

interface Reader {
  Read() string
}
interface Writer {
  Write(s string) void
}

type ReadWriter = Reader | Writer

struct ReadOnly {}

pub fn (r ReadOnly) Read() string { "data" }

fn UseRW(rw ReadWriter) void {
  io.Println(rw.Read())
}

pub fn Main() void {
  UseRW(ReadOnly{})
}
