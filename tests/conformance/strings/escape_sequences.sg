// Spec: \n, \r, \t, \\, \", \{ and \} escapes work in string literals. An
// escape the language does not define keeps its backslash.
// (docs/grammar.md — EscapeSequence)
import "std/io"

pub fn Main() void {
  io.Println("a\tb")
  io.Println("a\nb")
  io.Println("c\\d")
  io.Println("e\"f")
  io.Println("g\{h\}i")
  io.Println("j\qk")
}
