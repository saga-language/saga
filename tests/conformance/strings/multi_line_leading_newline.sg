// Spec: the newline directly after the opening `"""` is layout, not content,
// so a multiline string may start on its own line. Only one is dropped.
// (docs/language.md — Type Literals)
import "std/io"

pub fn Main() void {
  io.Println("""
alpha
beta""")
  io.Println("---")
  name := "world"
  io.Println("""
hello, {name}""")
  io.Println("---")
  io.Println("""

blank line kept""")
}
