// Spec: a method may bound its receiver's type parameter, and is then a method
// of every instance the bound admits — `numeric` admits both int and float.
import "std/io"

struct Box<T> {
  value T
}

pub fn (b Box<T numeric>) Twice() T { b.value + b.value }

pub fn Main() void {
  n := Box{value: 21}
  f := Box{value: 0.25}
  io.Println("{n.Twice()}")
  io.Println("{f.Twice()}")
}
