// Substitution stops at a struct boundary, so the `T` in the returned
// `Box<T>` survives whatever the argument binds. Lowering it would read the
// value through the wrong layout, so the call is refused instead.
import "std/io"

struct Box<T> {
  value T
}

fn Wrap<T>(x T) Box<T> { Box{value: x} }

pub fn Main() void {
  b := Wrap(5)
  io.Println("{b.value}")
}
