// A generic method's body is checked at its declaration, with T abstract, so
// the error names T rather than the type the call binds it to.
import "std/io"

struct Stack<T> {
  items array{T}
}

pub fn (s Stack<T>) Top() T { s.items[0] }

pub fn Main() void {
  s := Stack{items: [1, 2, 3]}
  io.Println("{s.Top()}")
}
