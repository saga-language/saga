// Spec: a method takes its type parameters from its receiver, the only place a
// call has anything to bind one from, so it has no list of its own to declare
// another in.
import "std/io"

struct Box<T> {
  value T
}

pub fn (b Box<T>) Map<U>(f fn(T) U) U { f(b.value) }

fn show(x int) string { x.String() }

pub fn Main() void {
  b := Box{value: 21}
  io.Println(b.Map(show))
}
