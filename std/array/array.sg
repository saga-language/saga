// Package array provides methods on the Array intrinsic type.
// This is a stdlib package compiled with --stdlib; do not import directly.

extern fn saga_array_size<T>(a array{T}) int
extern fn saga_array_append<T>(a array{T}, elem T) array{T}
extern fn saga_array_at<T>(a array{T}, index int) T
extern fn saga_array_insert<T>(a array{T}, elem T, index int) array{T}
extern fn saga_array_pop<T>(a array{T}) T
extern fn saga_array_set<T>(a array{T}, index int, elem T) array{T}
extern fn saga_array_equals<T>(a array{T}, other array{T}) bool
extern fn saga_array_find<T>(a array{T}, elem T) int | error

pub fn (a array{T}) Size() int {
  saga_array_size(a)
}

pub fn (a array{T}) Append(elem T) array{T} {
  saga_array_append(a, elem)
}

pub fn (a array{T}) At(index int) T {
  saga_array_at(a, index)
}

pub fn (a array{T}) Insert(elem T, index int) array{T} {
  saga_array_insert(a, elem, index)
}

pub fn (a array{T}) Pop() T {
  saga_array_pop(a)
}

pub fn (a array{T}) Set(index int, elem T) array{T} {
  saga_array_set(a, index, elem)
}

pub fn (a array{T}) Find(elem T) int | error {
  saga_array_find(a, elem)
}

pub fn (a array{T}) Equals(other array{T}) bool {
  saga_array_equals(a, other)
}

pub fn (a array{T}) String() string {
  if a.Size() == 0 { return "[]" }
  s := "["
  first := true
  for v : a {
    if !first { s += ", " }
    if intrinsic_is_string(v) {
      s += "\"" + v.String() + "\""
    } else {
      s += v.String()
    }
    first = false
  }
  s + "]"
}
