// Package map provides methods on the Map intrinsic type.
// This is a stdlib package compiled with --stdlib; do not import directly.

extern fn saga_map_size<K, V>(m map{K: V}) int
extern fn saga_map_set<K, V>(m map{K: V}, key K, value V) void
extern fn saga_map_get<K, V>(m map{K: V}, key K) V
extern fn saga_map_has<K, V>(m map{K: V}, key K) bool
extern fn saga_map_remove<K, V>(m map{K: V}, key K) void
extern fn saga_map_keys<K, V>(m map{K: V}) array{K}
extern fn saga_map_equals<K, V>(m map{K: V}, other map{K: V}) bool

pub fn (m map{K: V}) Size() int {
  saga_map_size(m)
}

pub fn (m map{K: V}) Set(key K, value V) void {
  saga_map_set(m, key, value)
}

pub fn (m map{K: V}) At(key K) V {
  saga_map_get(m, key)
}

pub fn (m map{K: V}) Key?(key K) bool {
  saga_map_has(m, key)
}

pub fn (m map{K: V}) Remove(key K) void {
  saga_map_remove(m, key)
}

pub fn (m map{K: V}) Keys() array{K} {
  saga_map_keys(m)
}

pub fn (m map{K: V}) Equals(other map{K: V}) bool {
  saga_map_equals(m, other)
}

pub fn (m map{K: V}) String() string {
  if m.Size() == 0 { return "\{}" }
  s := "\{"
  first := true
  for k : m.Keys() {
    if !first { s += ", " }
    if intrinsic_is_string(k) {
      s += "\"" + k.String() + "\""
    } else {
      s += k.String()
    }
    s += ": "
    v := m.At(k)
    if intrinsic_is_string(v) {
      s += "\"" + v.String() + "\""
    } else {
      s += v.String()
    }
    first = false
  }
  s + "}"
}
