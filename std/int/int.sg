// Package int provides methods on the Int intrinsic type.
// This is a stdlib package compiled with --stdlib; do not import directly.

extern fn saga_int_to_string(i int) string
extern fn saga_int_hash(i int) int64
extern fn saga_int_format(i int, fmt string) string

pub fn (i int) String() string {
  saga_int_to_string(i)
}

pub fn (i int) Float() float {
  intrinsic_sitofp(i)
}

pub fn (i int) Float64() float64 {
  intrinsic_sitofp(i)
}

pub fn (i int) Equals(other int) bool {
  i == other
}

pub fn (i int) Hash() int64 {
  saga_int_hash(i)
}

pub fn (i int) Compare(other int) Comparison {
  if i < other {
    Comparison.Less
  } else {
    if i == other { Comparison.Equal }
    else { Comparison.Greater }
  }
}

pub fn (i int) Int() int {
  i
}

pub fn (i int) Int8() int8     { intrinsic_sext_i8(i) }
pub fn (i int) Int16() int16   { intrinsic_sext_i16(i) }
pub fn (i int) Int32() int32   { intrinsic_sext_i32(i) }
pub fn (i int) Int64() int64   { intrinsic_sext_i64(i) }
pub fn (i int) Uint8() uint8   { intrinsic_zext_u8(i) }
pub fn (i int) Uint16() uint16 { intrinsic_zext_u16(i) }
pub fn (i int) Uint32() uint32 { intrinsic_zext_u32(i) }
pub fn (i int) Uint64() uint64 { intrinsic_zext_u64(i) }

pub fn (i int) Char() Char {
  intrinsic_zext_u32(i)
}

pub fn (i int) Float32() float32 {
  intrinsic_sitofp32(i)
}

pub fn (i int) Format(fmt string) string {
  saga_int_format(i, fmt)
}

// --- Int8 ---
//
// Every Saga integer is stored in canonical i64 form, so the
// extension intrinsic picked is determined by the destination's
// signedness — IntN dests use sext_iN even when the source is
// unsigned.  String/Hash delegate to the Int variant since the C
// runtime only has an Int64 entry point.

pub fn (i int8) String() string { i.Int().String() }

pub fn (i int8) Equals(other int8) bool { i == other }

pub fn (i int8) Hash() int64 { i.Int().Hash() }

pub fn (i int8) Compare(other int8) Comparison {
  if i < other { Comparison.Less }
  else { if i == other { Comparison.Equal } else { Comparison.Greater } }
}

pub fn (i int8) Int() int       { intrinsic_sext_i64(i) }
pub fn (i int8) Int8() int8     { i }
pub fn (i int8) Int16() int16   { intrinsic_sext_i16(i) }
pub fn (i int8) Int32() int32   { intrinsic_sext_i32(i) }
pub fn (i int8) Int64() int64   { intrinsic_sext_i64(i) }
pub fn (i int8) Uint8() uint8   { intrinsic_zext_u8(i) }
pub fn (i int8) Uint16() uint16 { intrinsic_zext_u16(i) }
pub fn (i int8) Uint32() uint32 { intrinsic_zext_u32(i) }
pub fn (i int8) Uint64() uint64 { intrinsic_zext_u64(i) }
pub fn (i int8) Float() float   { intrinsic_sitofp(i) }
pub fn (i int8) Float32() float32 { intrinsic_sitofp32(i) }
pub fn (i int8) Float64() float64 { intrinsic_sitofp(i) }

