{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Saga",
  "scopeName": "source.saga",
  "fileTypes": ["sg"],

  "patterns": [
    { "include": "#comment" },
    { "include": "#string-multiline" },
    { "include": "#string" },
    { "include": "#keywords" },
    { "include": "#constant-numeric" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],

  "repository": {

    "comment": {
      "name": "comment.line.double-slash.saga",
      "begin": "//",
      "end": "$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.saga" }
      }
    },

    "keywords": {
      "comment": "Function-call pattern must come last so keyword/type/constant patterns win at the same offset (e.g. if(, for(, spawn(, int( stay keywords).",
      "patterns": [
        { "include": "#keyword-import" },
        { "include": "#keyword-modifier" },
        { "include": "#storage-fn" },
        { "include": "#declaration-name" },
        { "include": "#storage-type-shape" },
        { "include": "#storage-const-type" },
        { "include": "#type-primitive" },
        { "include": "#type-composite" },
        { "include": "#keyword-conditional" },
        { "include": "#keyword-loop" },
        { "include": "#keyword-switch" },
        { "include": "#keyword-case" },
        { "include": "#keyword-flow" },
        { "include": "#keyword-or" },
        { "include": "#keyword-spawn" },
        { "include": "#keyword-is" },
        { "include": "#constant-boolean" },
        { "include": "#constant-null" },
        { "include": "#function-call" }
      ]
    },

    "keyword-import": {
      "name": "keyword.control.import.saga",
      "match": "\\bimport\\b"
    },

    "keyword-modifier": {
      "name": "storage.modifier.saga",
      "match": "\\b(pub|extern)\\b"
    },

    "storage-fn": {
      "name": "storage.type.function.saga",
      "match": "\\bfn\\b"
    },

    "declaration-name": {
      "comment": "`error` is intentionally excluded — it is only ever a bare type (T | error).",
      "match": "\\b(struct|enum|interface|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.saga" },
        "2": { "name": "entity.name.type.saga" }
      }
    },

    "storage-type-shape": {
      "name": "storage.type.saga",
      "match": "\\b(struct|enum|interface|error)\\b"
    },

    "storage-const-type": {
      "name": "storage.type.saga",
      "match": "\\b(const|type)\\b"
    },

    "type-primitive": {
      "name": "support.type.primitive.saga",
      "match": "\\b(bool|byte|string|void|int8|int16|int32|int64|int|uint8|uint16|uint32|uint64|uint|float32|float64|float)\\b"
    },

    "type-composite": {
      "name": "support.type.builtin.saga",
      "match": "\\b(array|map)\\b"
    },

    "keyword-conditional": {
      "name": "keyword.control.conditional.saga",
      "match": "\\b(if|else)\\b"
    },

    "keyword-loop": {
      "name": "keyword.control.loop.saga",
      "match": "\\bfor\\b"
    },

    "keyword-switch": {
      "name": "keyword.control.switch.saga",
      "match": "\\bswitch\\b"
    },

    "keyword-case": {
      "name": "keyword.control.case.saga",
      "match": "\\bcase\\b"
    },

    "keyword-flow": {
      "name": "keyword.control.flow.saga",
      "match": "\\b(break|next|return)\\b"
    },

    "keyword-or": {
      "name": "keyword.control.or.saga",
      "match": "\\bor\\b"
    },

    "keyword-spawn": {
      "name": "keyword.control.spawn.saga",
      "match": "\\bspawn\\b"
    },

    "keyword-is": {
      "name": "keyword.operator.word.is.saga",
      "match": "\\bis\\b"
    },

    "constant-boolean": {
      "name": "constant.language.boolean.saga",
      "match": "\\b(true|false)\\b"
    },

    "constant-null": {
      "name": "constant.language.null.saga",
      "match": "\\bnull\\b"
    },

    "function-call": {
      "comment": "Identifier (opt trailing ?, opt generic cluster) immediately before '('. Covers defs, methods, and call sites. Must follow all keyword/type patterns.",
      "name": "entity.name.function.saga",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\??(?=\\s*(?:<[^<>]*>)?\\s*\\()"
    },

    "constant-numeric": {
      "patterns": [
        {
          "comment": "Float literal: 1.0, 1_000.5, 1.5e+3",
          "name": "constant.numeric.float.saga",
          "match": "\\b(\\d[\\d_]*\\.[\\d][\\d_]*(?:[eE][+-]?\\d[\\d_]*)?)\\b"
        },
        {
          "comment": "Binary integer: 0b1010",
          "name": "constant.numeric.integer.binary.saga",
          "match": "\\b(0[bB][01_]+)\\b"
        },
        {
          "comment": "Hexadecimal integer: 0x1a3f",
          "name": "constant.numeric.integer.hexadecimal.saga",
          "match": "\\b(0[xX][0-9a-fA-F_]+)\\b"
        },
        {
          "comment": "Octal integer: 0o755",
          "name": "constant.numeric.integer.octal.saga",
          "match": "\\b(0[oO][0-7_]+)\\b"
        },
        {
          "comment": "Decimal integer: 42, 1_000",
          "name": "constant.numeric.integer.decimal.saga",
          "match": "\\b(\\d[\\d_]*)\\b"
        }
      ]
    },

    "string-escape": {
      "name": "constant.character.escape.saga",
      "match": "\\\\[ntr\\\\\"{}]"
    },

    "string-interpolation": {
      "name": "meta.interpolation.saga",
      "begin": "(?<!\\\\)\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.saga" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.saga" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#string-multiline" },
        { "include": "#string" },
        { "include": "#keywords" },
        { "include": "#constant-numeric" },
        { "include": "#operator" },
        { "include": "#punctuation" },
        { "include": "#string-interpolation" }
      ]
    },

    "string-multiline": {
      "comment": "Triple-quoted multi-line string — must appear before single-line string",
      "name": "string.quoted.triple.saga",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.saga" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.saga" }
      },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#string-interpolation" }
      ]
    },

    "string": {
      "name": "string.quoted.double.saga",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.saga" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.saga" }
      },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#string-interpolation" }
      ]
    },

    "operator": {
      "patterns": [
        {
          "comment": "Safe-access / error-promotion ?: before .[( (x?.f, x?[i], x?()) or postfix after ]/) (data[i]?). A trailing identifier ? is left as part of the identifier.",
          "name": "keyword.operator.saga",
          "match": "\\?(?=[.\\[(])|(?<=[\\]\\)])\\?"
        },
        {
          "comment": "Multi-character operators — matched before single-char to avoid splitting",
          "name": "keyword.operator.saga",
          "match": ":=|\\+=|-=|\\*=|/=|==|!=|<=|>=|&&|\\|\\||\\*\\*|<<|>>|\\+\\+|--|\\.\\.\\.|\\.\\."
        },
        {
          "name": "keyword.operator.saga",
          "match": "[-+*/%!<>&|^~=]"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.saga",     "match": "," },
        { "name": "punctuation.separator.saga",           "match": ";" },
        { "name": "punctuation.separator.colon.saga",     "match": ":" },
        { "name": "punctuation.accessor.dot.saga",        "match": "\\." },
        { "name": "punctuation.definition.block.saga",    "match": "[{}]" },
        { "name": "punctuation.definition.brackets.saga", "match": "[\\[\\]]" },
        { "name": "punctuation.definition.parens.saga",   "match": "[()]" }
      ]
    }
  }
}
